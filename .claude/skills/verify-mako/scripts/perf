#!/bin/bash
# Performance budgets for Mako. Prints one PASS/FAIL line per budget with the
# measured median; exit status is the number of budgets missed (100 = skipped).
#
# Primary numbers come from inside Mako (MAKO_PERF=1, set by control-mako):
# time from the input event until the main thread next idles, and process start
# to first page loaded. Those are what a user feels. The end-to-end numbers seen
# through accessibility include ~50ms of macOS title-propagation delay that Mako
# cannot change, so they get loose backstop budgets only.
#
# Uses local data: pages so network speed never moves the numbers. Budgets sit
# ~1.5x above measured medians; a miss is a regression, not noise. Tighten them
# when things get faster. PERF_N (default 8) sets the number of fresh launches.
set -u
cd "$(dirname "$0")/../../../.."
C=.claude/skills/verify-mako/scripts/control-mako
M=verify-runs/.bin/makoctl
E=${MAKO_RUN:-verify-runs/latest}/evidence
N=${PERF_N:-8}
fails=0

APP_INTERACTIVE_MS=420 # in-app: process start to main thread idle after launch (median ~285)
APP_LAUNCH_MS=520     # in-app: process start to first page loaded, incl. WebKit start-up (median ~350)
APP_NEW_TAB_MS=55     # in-app: cmd+T event until main thread idle (median ~37)
APP_SWITCH_MS=22      # in-app: cmd+1 event until main thread idle (median ~14)
E2E_LAUNCH_MS=900     # backstop: launch command to title visible via AX
E2E_NEW_TAB_MS=200    # backstop: cmd+T to new title visible via AX
E2E_SWITCH_MS=150     # backstop: cmd+1 to title visible via AX
RSS_MB=170            # app process resident memory with 3 tabs loaded
BUNDLE_MB=5           # build/Mako.app on disk
CORE_US=200           # enforced inside the Rust test itself

now_ms() { python3 -c 'import time; print(int(time.time() * 1000))'; }
median() { sort -n | awk '{a[NR]=$1} END {print a[int((NR + 1) / 2)]}'; }
budget() {
  local name=$1 value=$2 limit=$3 unit=$4
  if [ -z "$value" ]; then echo "FAIL $name: no measurement"; fails=$((fails + 1))
  elif awk "BEGIN {exit !($value <= $limit)}"; then echo "PASS $name ${value}${unit} (budget ${limit}${unit})"
  else echo "FAIL $name ${value}${unit} (budget ${limit}${unit})"; fails=$((fails + 1)); fi
}
logpid=
trap '$C stop >/dev/null 2>&1; [ -n "$logpid" ] && kill "$logpid" 2>/dev/null' EXIT

# A loaded machine measures itself, not Mako: skip rather than report a false PASS or FAIL.
load=$(sysctl -n vm.loadavg | awk '{print int($2 + 0.5)}')
cores=$(sysctl -n hw.ncpu)
if [ "$load" -gt "$cores" ]; then
  echo "SKIP perf: machine busy (1-min load $load > $cores cores); inconclusive, rerun when idle"
  exit 100
fi

mkdir -p "$E"
applog="$E/perf-app.log"
log stream --level info --predicate 'subsystem == "com.wego.mako" AND eventMessage BEGINSWITH "perf "' --style compact >"$applog" 2>&1 &
logpid=$!
sleep 1

page() { echo "data:text/html,<title>$1</title><h1>$1</h1>"; }
launches=() news=() switches=() rss=0
for i in $(seq 1 "$N"); do
  $C stop >/dev/null 2>&1
  t0=$(now_ms)
  $C launch "" "$(page first)" >/dev/null || { echo "FAIL launch"; exit 99; }
  P=$($C pid)
  $M "$P" wait-title first 10 >/dev/null || { echo "FAIL first page never rendered"; exit 99; }
  launches+=($(($(now_ms) - t0)))
  sleep 0.3
  news+=($($M "$P" time-key cmd+t "New Tab – 2/2"))
  $M "$P" key escape
  sleep 0.3
  switches+=($($M "$P" time-key cmd+1 "first – 1/2"))
  if [ "$i" = "$N" ]; then
    $M "$P" key cmd+2; $M "$P" key cmd+l; $M "$P" type "$(page second)"; $M "$P" key return; $M "$P" wait-title second 5 >/dev/null
    $M "$P" key cmd+t; $M "$P" key cmd+l; $M "$P" type "$(page third)"; $M "$P" key return; $M "$P" wait-title third 5 >/dev/null
    sleep 1
    rss=$(($(ps -o rss= -p "$P") / 1024))
  fi
done
$C stop >/dev/null 2>&1
sleep 1
kill "$logpid" 2>/dev/null; wait "$logpid" 2>/dev/null; logpid=

app_ms() { grep -oE "perf $1 [0-9]+us" "$applog" | grep -oE '[0-9]+us' | tr -d us | median | awk '{printf "%.1f", $1 / 1000}'; }
app_interactive=$(app_ms launchToInteractive)
app_launch=$(app_ms launchToFirstPage)
app_new_tab=$(app_ms newTab)
app_switch=$(app_ms selectTab)
e2e_launch=$(printf '%s\n' "${launches[@]}" | median)
e2e_new_tab=$(printf '%s\n' "${news[@]}" | median)
e2e_switch=$(printf '%s\n' "${switches[@]}" | median)
bundle=$(( ($(du -sk build/Mako.app | cut -f1) + 1023) / 1024 ))

budget app-launch-to-interactive "$app_interactive" $APP_INTERACTIVE_MS ms
budget app-launch-to-first-page "$app_launch" $APP_LAUNCH_MS ms
budget app-new-tab "$app_new_tab" $APP_NEW_TAB_MS ms
budget app-tab-switch "$app_switch" $APP_SWITCH_MS ms
budget e2e-launch "$e2e_launch" $E2E_LAUNCH_MS ms
budget e2e-new-tab "$e2e_new_tab" $E2E_NEW_TAB_MS ms
budget e2e-tab-switch "$e2e_switch" $E2E_SWITCH_MS ms
budget memory-3-tabs "$rss" $RSS_MB MB
budget bundle-size "$bundle" $BUNDLE_MB MB
if out=$(cargo test --release -q --manifest-path core/Cargo.toml -- --ignored --nocapture perf_budget 2>&1); then
  echo "PASS core $(echo "$out" | grep -o 'parse+check: [^ ]*') per navigation (budget ${CORE_US}µs)"
else
  echo "FAIL core: $(echo "$out" | grep -o 'parse+check took .*' | head -1)"; fails=$((fails + 1))
fi

printf 'n=%s app_interactive=%s app_launch=%s app_new_tab=%s app_switch=%s e2e_launch=%s e2e_new_tab=%s e2e_switch=%s rss_mb=%s bundle_mb=%s\n' \
  "$N" "$app_interactive" "$app_launch" "$app_new_tab" "$app_switch" "$e2e_launch" "$e2e_new_tab" "$e2e_switch" "$rss" "$bundle" >>"$E/perf.log"
echo "== $fails budget(s) missed; history in $E/perf.log"
exit "$fails"
