#!/bin/bash
# Answers page dialogs through accessibility actions, without focus: a page silenced with
# "Don't show more dialogs from this page" stays silenced through its own reloads, and a
# page the person loads from the address bar starts unsilenced. Back across #fragment
# history stays in the same document, so it keeps silencing too. Needs Accessibility
# permission. Prints PASS/FAIL per check; exit status = failures.
set -u
cd "$(dirname "$0")/../../../.."
export MAKO_BACKGROUND=1 MAKO_RUN="$PWD/verify-runs/dialogs-ax"
C=.claude/skills/verify-mako/scripts/control-mako; M=verify-runs/.bin/makoctl
E="$MAKO_RUN/evidence"
fails=0; P=
check() { local name=$1; shift; if "$@" >/dev/null 2>&1; then echo "PASS $name"; else echo "FAIL $name"; fails=$((fails + 1)); fi; }
appears() { for _ in $(seq 40); do $M "$P" exists "$1" && return 0; sleep 0.1; done; return 1; }
absent() { $M "$P" exists mako.page || return 1; $M "$P" exists "$1"; test $? = 4; }
omni() { $M "$P" menu File "Open Location…"; sleep 0.3; $M "$P" set mako.omnibox.field "$1"; $M "$P" confirm mako.omnibox.field; }
silence_second() {
  check "$1-first-alert-shows" appears mako.dialog.ok
  $M "$P" press-id mako.dialog.ok; sleep 0.5
  check "$1-second-alert-offers-silence" appears mako.dialog.silence
  $M "$P" press-id mako.dialog.silence
  check "$1-silence-ticked" test "$($M "$P" value mako.dialog.silence)" = 1
  $M "$P" press-id mako.dialog.ok >/dev/null 2>&1
}
trap '$C stop >/dev/null 2>&1; kill $srv 2>/dev/null; wait $srv 2>/dev/null' EXIT

$C stop >/dev/null 2>&1
$C build >/dev/null || { echo "FAIL build"; exit 99; }
mkdir -p "$E"
port=$((20000 + RANDOM % 20000)); U="http://127.0.0.1:$port"
python3 -m http.server "$port" --bind 127.0.0.1 -d .claude/skills/verify-mako/fixtures/dialogs >/dev/null 2>&1 &
srv=$!; sleep 1
out=$($C launch "" "$U/silence-then-leave.html" 2>&1) || { echo "FAIL launch: $out"; exit 99; }
P=$($C pid)

silence_second leave
check leave-alerts-done sh -c "$M $P wait-title alerts:done 3"
omni "$U/confirm.html"
check address-bar-confirm-shows appears mako.dialog.ok
$M "$P" shot "$E/confirm-after-silence.png" >/dev/null 2>&1
$M "$P" press-id mako.dialog.ok >/dev/null 2>&1
check address-bar-confirm-answered sh -c "$M $P wait-title confirm:true 3"

omni "$U/reload-loop.html"
silence_second reload
check script-reload-keeps-silence sh -c "$M $P wait-title reloads:done 6"
$M "$P" shot "$E/after-reloads.png" >/dev/null 2>&1
check script-reload-no-sheet absent mako.dialog.ok

omni "$U/fragment-back.html"
silence_second fragment
check fragment-alerts-done sh -c "$M $P wait-title alerts:done 3"
$M "$P" press "to a"; sleep 0.3; $M "$P" press "to b"; sleep 0.3
$M "$P" menu History Back
check fragment-back-then-script-reload-keeps-silence sh -c "$M $P wait-title reload:done 6"
$M "$P" shot "$E/after-fragment-back.png" >/dev/null 2>&1
check fragment-reload-no-sheet absent mako.dialog.ok
echo "== $fails failure(s); evidence in $E"
exit "$fails"
