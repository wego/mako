#!/bin/sh
# Launches and tears down an isolated Mako for verification. State per run lives
# in $MAKO_RUN (default: ./verify-runs/latest); evidence goes to $MAKO_RUN/evidence.
# Each run drives its own copy of the app with its own bundle ID, so cookies,
# logins, caches, web storage and preferences never mix with the daily Mako or
# with other runs: macOS and WebKit key all of them by bundle ID.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../../../.." && pwd)
run=${MAKO_RUN:-$repo/verify-runs/latest}
case "$run" in /*) ;; *) run="$PWD/$run" ;; esac
bin="$repo/verify-runs/.bin/makoctl"
app="$run/app/Mako.app"
exe="$app/Contents/MacOS/Mako"
id="com.wego.mako.verify.$(basename "$run" | tr -c 'a-zA-Z0-9\n' '-')"

# The run's copy of build/Mako.app, refreshed when the build is newer. It drops the
# http/https URL handlers so macOS never offers the copy as a browser for real links.
prepare_app() {
  [ -x "$exe" ] && [ ! "$repo/build/Mako.app/Contents/MacOS/Mako" -nt "$exe" ] && return 0
  rm -rf "$app"; mkdir -p "$run/app"
  cp -R "$repo/build/Mako.app" "$app"
  /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $id" -c "Delete :CFBundleURLTypes" "$app/Contents/Info.plist"
  codesign --force --sign - "$app" 2>/dev/null
}

# Deletes everything macOS and WebKit stored for this run's bundle ID.
wipe_data() {
  case "$id" in com.wego.mako.verify.?*) ;; *) echo "refusing to wipe data for $id"; exit 1 ;; esac
  rm -rf "$HOME/Library/WebKit/$id" "$HOME/Library/Caches/$id" "$HOME/Library/HTTPStorages/$id" \
    "$HOME/Library/HTTPStorages/$id.binarycookies" "$HOME/Library/Saved Application State/$id.savedState"
  defaults delete "$id" >/dev/null 2>&1 || true
  rm -f "$HOME/Library/Preferences/$id.plist"
}

makoctl_build() {
  mkdir -p "$(dirname "$bin")"
  if [ ! -x "$bin" ] || [ "$here/makoctl.swift" -nt "$bin" ]; then
    swiftc -O "$here/makoctl.swift" -o "$bin"
  fi
}

refuse_if_running() {
  [ -f "$run/pid" ] && kill -0 "$(cat "$run/pid")" 2>/dev/null && { echo "already running: pid $(cat "$run/pid")"; exit 1; }
  return 0
}

# start [url...]: opens the run's app copy on the existing $run/state (config, session.json).
start() {
  # LaunchServices launch (-n: separate instance); a bare exec gets no key events.
  open -n -a "$app" --env MAKO_CONFIG="$run/state/config" --args "$@"
  i=0
  until pid=$(pgrep -f "$exe" | head -1) && [ -n "$pid" ]; do
    i=$((i + 1)); [ $i -gt 50 ] && { echo "process never started"; exit 1; }
    sleep 0.2
  done
  echo "$pid" > "$run/pid"
  i=0
  until "$bin" "$pid" title >/dev/null 2>&1; do
    i=$((i + 1)); [ $i -gt 50 ] && { echo "window never appeared: $("$bin" "$pid" title 2>&1)"; exit 1; }
    sleep 0.2
  done
  echo "pid $pid ready; bundle id $id; config $run/state/config; evidence $run/evidence"
}

case "${1:-}" in
build)
  "$repo/script/bundle" >/dev/null
  makoctl_build
  echo "built $repo/build/Mako.app and $bin"
  ;;
launch)
  # launch [config-file|""] [url...]: fresh state (default config, no session, no website data), then start.
  shift
  refuse_if_running
  [ -x "$repo/build/Mako.app/Contents/MacOS/Mako" ] || { echo "no build; run: control-mako build"; exit 1; }
  wipe_data
  prepare_app
  rm -rf "$run/state"; mkdir -p "$run/state" "$run/evidence"
  printf 'max_tabs = 3\nblock x.com\n' > "$run/state/config"
  if [ $# -gt 0 ]; then
    if [ -f "$1" ]; then cp "$1" "$run/state/config"; elif [ -n "$1" ]; then echo "no config file $1 (pass \"\" for the default)"; exit 64; fi
    shift
  fi
  start "$@"
  ;;
relaunch)
  # relaunch [url...]: start again on the state the last instance left (session restore).
  shift
  refuse_if_running
  [ -f "$run/state/config" ] || { echo "no state in $run; use launch"; exit 1; }
  start "$@"
  ;;
quit)
  # Graceful Cmd-Q via the menu so applicationWillTerminate runs; keeps state.
  pid=$(cat "$run/pid")
  "$bin" "$pid" menu Mako "Quit Mako"
  i=0
  while kill -0 "$pid" 2>/dev/null; do
    i=$((i + 1)); [ $i -gt 50 ] && { echo "pid $pid did not quit"; exit 1; }
    sleep 0.2
  done
  rm -f "$run/pid"
  echo "quit pid $pid; state kept in $run/state"
  ;;
pid)
  cat "$run/pid"
  ;;
doctor)
  [ -x "$bin" ] || { echo "FAIL makoctl not built (run: control-mako build)"; exit 1; }
  [ -f "$run/pid" ] || { echo "FAIL no launched instance in $run"; exit 1; }
  pid=$(cat "$run/pid")
  kill -0 "$pid" 2>/dev/null || { echo "FAIL pid $pid not running"; exit 1; }
  comm=$(ps -o comm= -p "$pid")
  [ "$comm" = "$exe" ] || { echo "FAIL pid $pid is $comm, not this run's app copy"; exit 1; }
  [ ! "$repo/build/Mako.app/Contents/MacOS/Mako" -nt "$exe" ] || { echo "FAIL running copy is older than build/Mako.app; stop and launch again"; exit 1; }
  ax=$("$bin" "$pid" title 2>&1) || { echo "FAIL accessibility: $ax"; exit 1; }
  "$bin" "$pid" shot "$run/state/doctor.png" >/dev/null || { echo "FAIL screen recording unavailable"; exit 1; }
  echo "OK pid $pid id $id build $(stat -f %Sm "$exe") title \"$("$bin" "$pid" title)\""
  ;;
stop)
  if [ -f "$run/pid" ]; then
    pid=$(cat "$run/pid")
    kill "$pid" 2>/dev/null || true
    i=0
    while kill -0 "$pid" 2>/dev/null && [ $i -lt 50 ]; do i=$((i + 1)); sleep 0.1; done
    rm -f "$run/pid"
    echo "stopped pid $pid"
  fi
  wipe_data
  rm -rf "$run/state"
  ;;
*)
  echo "usage: control-mako build | launch [config-file|\"\"] [url...] | quit | relaunch [url...] | pid | doctor | stop"
  echo "drive: $bin <pid> <command>   (run $bin with no args for commands)"
  exit 64
  ;;
esac
