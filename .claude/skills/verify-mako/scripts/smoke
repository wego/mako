#!/bin/bash
# The full pass: the core's tests, then builds once and runs every check script and perf
# in turn. The background scripts and perf take no focus. SMOKE_HEADED=1 adds the headed
# scripts (ux, settings, chrome, sidebar, omnibox-keys), which take the keyboard and pointer, and lets perf time real ⌘T
# and ⌘1 presses. Prints each script's PASS/FAIL lines, then one SUMMARY line per
# script. Exit status is the total number of failures (capped at 255).
set -u
cd "$(dirname "$0")/../../../.."
S=.claude/skills/verify-mako/scripts
fails=0
summary=()

# step <script>: runs it and adds its failures; 99 means it could not start, 98 that pointer
# events do not reach Mako (one failure each).
step() {
  local name=$1 code
  echo "== $name"
  "$S/$name"; code=$?
  case $code in
    99) summary+=("SUMMARY $name could not start"); fails=$((fails + 1)) ;;
    98) summary+=("SUMMARY $name pointer events don't reach Mako: run at the Mac"); fails=$((fails + 1)) ;;
    100) summary+=("SUMMARY $name skipped (machine busy)") ;;
    *) summary+=("SUMMARY $name $code failure(s)"); fails=$((fails + code)) ;;
  esac
}

step doc-check
# The core's tests run in CI too; here they also gate the rest of the local pass.
echo "== cargo test"
cargo test -q --manifest-path core/Cargo.toml || { summary+=("SUMMARY cargo test failed"); fails=$((fails + 1)); }
"$S/control-mako" build >/dev/null || { echo "FAIL build"; exit 99; }
export MAKO_SKIP_BUILD=1

for name in trails-bg trails-ax chrome-ax dialogs-bg dialogs-ax omnibox-ax isolation-ax; do step "$name"; done
if [ "${SMOKE_HEADED:-}" = 1 ]; then
  for name in ux-headed settings-headed chrome-headed sidebar-headed omnibox-keys-headed; do step "$name"; done
  MAKO_BACKGROUND= step perf
else
  echo "== skipping ux-headed and settings-headed (they take the keyboard and pointer; SMOKE_HEADED=1 runs them)"
  MAKO_BACKGROUND=1 step perf
fi

printf '%s\n' "${summary[@]}"
echo "== $fails failure(s); evidence in verify-runs/<script>/evidence and verify-runs/latest/evidence (perf)"
exit "$((fails > 255 ? 255 : fails))"
