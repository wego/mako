#!/bin/bash
# Runs every features/*.md recipe against a fresh isolated Mako and prints one
# PASS/FAIL line per check. Exit status is the number of failures (0 = all pass).
# Takes focus for ~2 minutes. Evidence: $MAKO_RUN/evidence (default verify-runs/latest).
set -u
cd "$(dirname "$0")/../../../.."
C=.claude/skills/verify-mako/scripts/control-mako
M=verify-runs/.bin/makoctl
run=${MAKO_RUN:-verify-runs/latest}
E=$run/evidence
fails=0
P=

pass() { echo "PASS $1"; }
fail() { echo "FAIL $1"; fails=$((fails + 1)); }
check() { local name=$1; shift; if "$@" >/dev/null 2>&1; then pass "$name"; else fail "$name ($($M "$P" title 2>/dev/null))"; fi; }
s() { sleep "${1:-0.4}"; }
launch() {
  $C stop >/dev/null 2>&1
  local out
  out=$($C launch "$@" 2>&1 && $C doctor 2>&1) || { fail "launch: $(echo "$out" | tail -1)"; exit 99; }
  P=$($C pid)
}
go() { $M "$P" key cmd+l; s 0.3; $M "$P" type "$1"; $M "$P" key return; }
has_tree() { $M "$P" tree "${2:-8}" | grep -q "$1"; }
trap '$C stop >/dev/null 2>&1' EXIT

.claude/skills/verify-mako/scripts/doc-check || fails=$((fails + $?))
$C build >/dev/null || { echo "FAIL build"; exit 99; }
mkdir -p "$E"

echo "== omnibox"
launch "" https://example.com
check omni-start $M "$P" wait-title "Example Domain – 1/1" 8
$M "$P" key cmd+l; s
check omni-open-prefill test "$($M "$P" value mako.omnibox.field)" = "https://example.com/"
check omni-status sh -c "$M $P value mako.omnibox.status | grep -q '1/3 tabs'"
$M "$P" type zzz; $M "$P" key escape; s
check omni-dismiss $M "$P" wait-title "Example Domain – 1/1" 2
$M "$P" menu File "Open Location…"; s
check omni-open-menu $M "$P" exists mako.omnibox.field
$M "$P" key escape; s
go "rust lifetimes"
check omni-search $M "$P" wait-title "rust lifetimes" 8
go example.com
check omni-url $M "$P" wait-title "Example Domain" 8

echo "== accessibility"
$M "$P" tree 8 >"$E/ax-page.txt"
check ax-web grep -q 'AXWebArea desc="Example Domain"' "$E/ax-page.txt"
check ax-link grep -q 'AXLink title="Learn more"' "$E/ax-page.txt"
$M "$P" key cmd+l; s
$M "$P" tree 9 >"$E/ax-omnibox.txt"
for id in mako.page mako.tab.1 mako.omnibox mako.omnibox.field mako.omnibox.status; do
  check "ax-id $id" grep -q "id=\"$id\"" "$E/ax-omnibox.txt"
done
$M "$P" key escape; s
check ax-no-systabs sh -c "! $M $P tree 4 | grep -q AXTabGroup"

echo "== navigation"
go iana.org
check nav-load $M "$P" wait-title "Internet Assigned" 10
$M "$P" key "cmd+["
check nav-back $M "$P" wait-title "Example Domain" 8
$M "$P" key "cmd+]"
check nav-forward $M "$P" wait-title "Internet Assigned" 8
$M "$P" menu History Back
check nav-back-menu $M "$P" wait-title "Example Domain" 8
$M "$P" shot "$E/zoom-1.png" >/dev/null; $M "$P" key "cmd+="; $M "$P" key "cmd+="; s 0.8; $M "$P" shot "$E/zoom-2.png" >/dev/null
check nav-zoom-changes-pixels sh -c "! cmp -s $E/zoom-1.png $E/zoom-2.png"
$M "$P" key cmd+0

echo "== devtools"
$M "$P" key cmd+opt+c; s 2.5
check devtools-open test "$($M "$P" tree 12 | grep -c AXWebArea)" -ge 2
$M "$P" shot "$E/console-open.png" >/dev/null
$M "$P" type 'document.title="from console"'; $M "$P" key return
check devtools-eval $M "$P" wait-title "from console" 4
$M "$P" key cmd+opt+c; s 4
check devtools-close test "$($M "$P" tree 12 | grep -c AXWebArea)" -eq 1

echo "== tabs"
$M "$P" key cmd+t; s
check tab-new $M "$P" wait-title "New Tab – 2/2" 2
check tab-blank-icon $M "$P" exists mako.blank
$M "$P" shot "$E/tab-blank.png" >/dev/null
$M "$P" key escape; s; $M "$P" menu File "New Tab"; s; $M "$P" key escape; s
check tab-new-menu $M "$P" wait-title "New Tab – 3/3" 2
$M "$P" key cmd+t; s
check tab-cap sh -c "$M $P value mako.omnibox.status | grep -q 'Tab cap reached (3)'"
check tab-cap-count $M "$P" wait-title "– 3/3" 1
$M "$P" key escape; s; $M "$P" key cmd+1
check tab-switch-key $M "$P" wait-title "– 1/3" 3
check tab-menu-checked sh -c "$M $P menu-items Tabs | head -1 | grep -q '^\*'"
$M "$P" menu Tabs "New Tab"; s
check tab-switch-menu $M "$P" wait-title "New Tab – 2/3" 2
for _ in 1 2 3; do $M "$P" key cmd+w; s; done
check tab-close-to-last $M "$P" wait-title "New Tab – 1/1" 2
check tab-last-blank $M "$P" exists mako.blank

echo "== blocklist"
log stream --level info --predicate 'subsystem == "com.chuyeow.mako"' --style compact >"$E/block-log.txt" 2>&1 &
logpid=$!; s 1
go x.com
check block-typed sh -c "sleep 2; $M $P tree 8 | grep -q 'x.com is blocked'"
check block-title $M "$P" wait-title "Not now." 2
$M "$P" shot "$E/block-page.png" >/dev/null
go mobile.x.com
check block-subdomain sh -c "sleep 2; $M $P tree 8 | grep -q 'x.com is blocked'"
go example.com
check block-allowed $M "$P" wait-title "Example Domain" 8
embed="data:text/html,<title>embed</title><p>host page</p><iframe src='https://x.com/'></iframe><iframe src='https://www.iana.org/'></iframe>"
go "$embed"
check block-iframe sh -c "sleep 3; grep -q 'block x.com (frame)' $E/block-log.txt"
check block-iframe-host-loads $M "$P" wait-title "embed" 2
check block-iframe-allowed-frame sh -c "grep -q 'allow https://www.iana.org/' $E/block-log.txt"
go example.com; $M "$P" wait-title "Example Domain" 8 >/dev/null
echo 'block example.com' >>"$run/state/config"
$M "$P" key cmd+r
check block-live-edit sh -c "sleep 2; $M $P tree 8 | grep -q 'example.com is blocked'"
kill "$logpid" 2>/dev/null; wait "$logpid" 2>/dev/null
check block-log grep -q "block mobile.x.com" "$E/block-log.txt"

echo "== popups (sign-in)"
port=$((20000 + RANDOM % 20000))
python3 -m http.server "$port" --bind 127.0.0.1 -d .claude/skills/verify-mako/fixtures >/dev/null 2>&1 &
srv=$!; s 1
go "http://127.0.0.1:$port/oauth-opener.html"
check popup-fixture-loads $M "$P" wait-title "opener" 8
$M "$P" press "Continue with Provider"
check popup-opener-gets-token $M "$P" wait-title "signed in" 6
check popup-closes sh -c "sleep 1; ! $M $P windows | grep -q mako.popup"
check popup-not-a-tab $M "$P" wait-title "signed in – 1/1" 1
$M "$P" press "plain target=_blank link"
check blank-link-same-tab $M "$P" wait-title "provider – 1/1" 6
kill "$srv" 2>/dev/null; wait "$srv" 2>/dev/null

echo "== page shortcuts"
probe="data:text/html,<title>probe</title><script>addEventListener('keydown',e=>{if(e.metaKey){e.preventDefault();document.title='got '+e.key}})</script><body contenteditable>edit</body>"
launch "" "$probe"
$M "$P" wait-title probe 5 >/dev/null
$M "$P" key cmd+z
check keys-page-cmd-z $M "$P" wait-title "got z" 3
$M "$P" key cmd+r
check keys-page-cmd-r $M "$P" wait-title "got r" 3
$M "$P" key cmd+t
check keys-mako-cmd-t $M "$P" wait-title "– 2/2" 3

echo "== session"
launch "" https://example.com
$M "$P" wait-title "Example Domain" 8 >/dev/null
go iana.org; $M "$P" wait-title "Internet Assigned" 10 >/dev/null
$M "$P" key "cmd+["; $M "$P" wait-title "Example Domain" 8 >/dev/null
$M "$P" key cmd+t; s; go iana.org; $M "$P" wait-title "Internet Assigned" 10 >/dev/null
$M "$P" key cmd+t; s; $M "$P" key escape; s; $M "$P" key cmd+1; s
$C quit >/dev/null
cp "$run/state/session.json" "$E/session.json" 2>/dev/null
check session-save sh -c "grep -q example.com $run/state/session.json && grep -q iana.org $run/state/session.json && grep -q '\"active\":0' $run/state/session.json"
$C relaunch >/dev/null; P=$($C pid)
check session-restore $M "$P" wait-title "Example Domain – 1/2" 8
$M "$P" shot "$E/session-restored.png" >/dev/null
$M "$P" key cmd+2; s; $C quit >/dev/null
$C relaunch https://example.org >/dev/null; P=$($C pid)
check session-plus-link $M "$P" wait-title "– 3/3" 8
echo 'restore_session = false' >>"$run/state/config"
$C quit >/dev/null; $C relaunch >/dev/null; P=$($C pid)
check session-off $M "$P" wait-title "New Tab – 1/1" 5
$C quit >/dev/null
check session-off-deletes test ! -e "$run/state/session.json"

echo "== perf"
$C stop >/dev/null 2>&1
.claude/skills/verify-mako/scripts/perf | grep -v '^==' | while read -r line; do echo "$line"; done
perf_fails=${PIPESTATUS[0]}
if [ "$perf_fails" = 100 ]; then echo "SKIP perf budgets not checked (busy machine)"; else fails=$((fails + perf_fails)); fi

echo "== $fails failure(s); evidence in $E"
exit "$fails"
