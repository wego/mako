#!/bin/bash
# Drives the trails UI through accessibility actions without taking focus: sidebar
# rows, collapse, the omnibox, the trail cap, live config edits, close, Undo Close (also
# after a restart).
# Needs Accessibility permission for the terminal; no keys are sent, so it is safe to
# run while the Mac is in use. Prints PASS/FAIL per check; exit status = failures.
set -u
cd "$(dirname "$0")/../../../.."
export MAKO_BACKGROUND=1 MAKO_RUN="$PWD/verify-runs/trails-ax"
C=.claude/skills/verify-mako/scripts/control-mako; M=verify-runs/.bin/makoctl
J="$MAKO_RUN/state/trails.json"; E="$MAKO_RUN/evidence"
fails=0; P=
pass() { echo "PASS $1"; }
fail() { echo "FAIL $1"; fails=$((fails + 1)); }
check() { local name=$1; shift; if "$@" >/dev/null 2>&1; then pass "$name"; else fail "$name ($(q 'str(s["active"])+" "+str(s["roots"])' 2>/dev/null))"; fi; }
# q <python expression over s>: reads the saved state
q() { python3 -c "import json; s=json.load(open('$J')); n=s['nodes']; print($1)"; }
is() { test "$(q "$1")" = "$2"; }
# within <command...>: polls for up to 2 s
within() { for _ in $(seq 20); do "$@" >/dev/null 2>&1 && return 0; sleep 0.1; done; return 1; }
front() { osascript -e 'tell application "System Events" to get name of first process whose frontmost is true' 2>/dev/null; }
# inked <png> <ax-id>: that element's rect in a window shot holds ink, not just flat paper
inked() {
  read -r wx wy ww _ <<<"$($M "$P" window-frame)"; read -r x y w h <<<"$($M "$P" frame "$2")"
  sips -s format bmp "$1" --out "$1.bmp" >/dev/null 2>&1 && python3 -I -c '
import struct, sys
b = open(sys.argv[1], "rb").read()
off, W, H, bpp = struct.unpack_from("<I", b, 10)[0], *struct.unpack_from("<ii", b, 18), struct.unpack_from("<H", b, 28)[0] // 8
k = W / float(sys.argv[2]); x, y, w, h = (round(float(v) * k) for v in sys.argv[3:7])
stride = (W * bpp + 3) // 4 * 4
lum = [sum(b[i:i + 3]) / 3 for yy in range(y, y + h) for i in
       [off + ((H - 1 - yy) if H > 0 else yy) * stride + xx * bpp for xx in range(x, x + w)]]
sys.exit(0 if max(lum) - min(lum) > 20 else 1)' "$1.bmp" "$ww" $((x - wx)) $((y - wy)) "$w" "$h"
}
# ring <png>: the omnibox ring's colour in a window shot, mid top edge: "neutral" for an
# unsaturated ink, else "slot <n>" for the nearest trail ink (light or dark variant) in reach
ring() {
  read -r wx wy ww _ <<<"$($M "$P" window-frame)"; read -r x y w _ <<<"$($M "$P" frame mako.omnibox)"
  sips -s format bmp "$1" --out "$1.bmp" >/dev/null 2>&1 && python3 -I -c '
import struct, sys
b = open(sys.argv[1], "rb").read()
off, W, H, bpp = struct.unpack_from("<I", b, 10)[0], *struct.unpack_from("<ii", b, 18), struct.unpack_from("<H", b, 28)[0] // 8
k = W / float(sys.argv[2]); x, y = round(float(sys.argv[3]) * k), round((float(sys.argv[4]) - 0.75) * k)
i = off + ((H - 1 - y) if H > 0 else y) * ((W * bpp + 3) // 4 * 4) + x * bpp
px = (b[i + 2], b[i + 1], b[i])
inks = [(0x839d56, 0x97b561), (0x46648c, 0x92add2), (0xc7735f, 0xe29988), (0xd9902a, 0xebb060), (0x7a4fa0, 0xb690dc),
        (0x2f7f7a, 0x6cbfb8), (0x8c3a5a, 0xd59ab1), (0x2f6b3a, 0x6fae7c), (0x8a6a3a, 0xc4a274)]
rgb = lambda h: (h >> 16, h >> 8 & 255, h & 255)
d, slot = min((sum((a - c) ** 2 for a, c in zip(px, rgb(h))) ** 0.5, n) for n, pair in enumerate(inks) for h in pair)
print("neutral" if max(px) - min(px) < 30 else f"slot {slot}" if d < 40 else f"unknown {px}")' "$1.bmp" "$ww" $((x - wx + w / 2)) $((y - wy))
}
# ringis <png> <expected>: ring's reading, kept in the evidence beside the shot
ringis() { local got; got=$(ring "$1" 2>&1); echo "$got" > "${1%.png}.ring.txt"; test "$got" = "$2"; }
# unpainted <png> <ax-id>: the element is in the tree with a frame, but its rect is flat paper
unpainted() { $M "$P" frame "$2" >/dev/null 2>&1 && ! inked "$@"; }
omni() { $M "$P" menu File "$1"; sleep 0.3; $M "$P" set mako.omnibox.field "$2"; $M "$P" confirm mako.omnibox.field; sleep "${3:-2}"; }
trap '$C stop >/dev/null 2>&1; kill $srv 2>/dev/null; wait $srv 2>/dev/null' EXIT

$C stop >/dev/null 2>&1
[ "${MAKO_SKIP_BUILD:-}" = 1 ] || $C build >/dev/null || { echo "FAIL build"; exit 99; }
mkdir -p "$E"
port=$((20000 + RANDOM % 20000))
python3 -m http.server "$port" --bind 127.0.0.1 -d .claude/skills/verify-mako/fixtures/trails >/dev/null 2>&1 &
srv=$!; sleep 1
U="http://127.0.0.1:$port"
before=$(front)
out=$($C launch "" "$U/a.html" 2>&1) || { echo "FAIL launch: $out"; exit 99; }
P=$($C pid); sleep 4

echo "== sidebar"
check sidebar-lists-the-trail sh -c "$M $P menu-items Trails | grep -q '^\* Page C'"
$M "$P" press-id mako.trail.1; sleep 0.8
check row-press-selects is 's["active"]' 1
check title-follows-selection test "$($M "$P" title)" = "Page A"
check row-marked-selected test "$($M "$P" value mako.trail.1)" = selected
$M "$P" press-id mako.trail.3; sleep 0.5; $M "$P" press-id mako.trail.1.toggle; sleep 0.5
check collapse-hides-children sh -c "! $M $P menu-items Trails | grep -q 'Page B'"
check collapse-moves-to-collapsed-page is 's["active"]' 1
$M "$P" press-id mako.trail.1.toggle; sleep 0.5
check expand-shows-children sh -c "$M $P menu-items Trails | grep -q 'Page B'"
$M "$P" menu Trails "Page C"; sleep 0.5
check menu-selects is 's["active"]' 3
$M "$P" menu Trails "Previous Page"; sleep 0.4
check previous-page is 's["active"]' 2
$M "$P" menu Trails "Next Page"; sleep 0.4
check next-page is 's["active"]' 3

echo "== row controls"
check every-row-has-a-close-control test "$($M "$P" tree | grep -c 'id=\"mako\.trail\.[0-9]*\.close\"')" = 3
$M "$P" shot "$E/rows-no-hover.png" >/dev/null
check close-control-has-a-frame $M "$P" frame mako.trail.3.close
check no-close-without-hover unpainted "$E/rows-no-hover.png" mako.trail.3.close
check no-expanded-toggle-without-hover unpainted "$E/rows-no-hover.png" mako.trail.1.toggle
$M "$P" press-id mako.trail.1.toggle; sleep 0.5
$M "$P" shot "$E/rows-collapsed.png" >/dev/null
check collapsed-toggle-shows-faintly inked "$E/rows-collapsed.png" mako.trail.1.toggle
$M "$P" press-id mako.trail.1.toggle; sleep 0.5; $M "$P" press-id mako.trail.3; sleep 0.5
cp "$J" "$E/pre-close-control.json"
$M "$P" press-id mako.trail.3.close; sleep 0.6
check close-control-closes-its-page is '(sorted(n), s["active"])' "(['1', '2'], 2)"
$M "$P" menu File "Reopen Closed Page"; sleep 1
check reopen-undoes-close-control cmp -s "$J" "$E/pre-close-control.json"

echo "== jump to a trail (⌘1…⌘9 items)"
$M "$P" menu Trails "Page A"; sleep 0.4
check jump-from-inside-goes-to-root is 's["active"]' 1
$M "$P" menu Trails "Page A"; sleep 0.4
check jump-from-root-goes-to-last-page is 's["active"]' 3
$M "$P" menu Trails "Page A"; sleep 0.4
check jump-from-last-page-goes-to-root is 's["active"]' 1
check jump-item-has-cmd-1 sh -c "$M $P tree 20 --menus | grep -q 'title=\"Page A\".*cmd=\"1\"'"

echo "== sidebar width"
check default-width-is-a-fifth-of-the-window test "$($M "$P" value mako.divider)" = 240
$M "$P" set mako.divider 300; sleep 0.3
check width-can-be-set test "$($M "$P" value mako.divider)" = 300
$M "$P" set mako.divider 9999; sleep 0.3
check width-is-capped test "$($M "$P" value mako.divider)" = 480
$M "$P" set mako.divider 300; sleep 0.3

echo "== settings"
CF="$MAKO_RUN/state/config"
$M "$P" menu Mako "Settings…"; sleep 0.5
check settings-shows-default-cap test "$($M "$P" value mako.settings.maxTrails)" = 3
check settings-stays-in-background test "$(front)" = "$before"
$M "$P" set mako.settings.maxTrails 0; $M "$P" confirm mako.settings.maxTrails; sleep 0.3
check settings-refuses-zero sh -c "test \"\$($M $P value mako.settings.maxTrails)\" = 3 && grep -qx 'max_trails = 3' '$CF'"
$M "$P" set mako.settings.maxTrails 2; $M "$P" confirm mako.settings.maxTrails; sleep 0.3
check settings-writes-config grep -qx 'max_trails = 2' "$CF"
check settings-keeps-other-lines grep -qx 'block x.com' "$CF"
check default-config-has-no-max-tabs sh -c "! grep -q max_tabs '$CF'"
$M "$P" set mako.settings.maxTrails 1; $M "$P" confirm mako.settings.maxTrails
check settings-cap-redraws-load-note within sh -c "test \"\$($M $P value mako.sidebar.load)\" = '🧠 1/1'"
$M "$P" set mako.settings.maxTrails 2; $M "$P" confirm mako.settings.maxTrails
check settings-cap-hides-load-note within sh -c "! $M $P exists mako.sidebar.load"

echo "== live config edits"
cp "$CF" "$E/config.good"
{ cat "$E/config.good"; echo 'colour = red'; } > "$CF.new"; mv "$CF.new" "$CF"
check saved-edit-shows-config-note within $M "$P" exists mako.sidebar.config
cp "$E/config.good" "$CF.new"; mv "$CF.new" "$CF"
check saved-fix-hides-config-note within sh -c "! $M $P exists mako.sidebar.config"
echo 'colour = red' >> "$CF"
check in-place-edit-shows-config-note within $M "$P" exists mako.sidebar.config
cat "$E/config.good" > "$CF"
check in-place-fix-hides-config-note within sh -c "! $M $P exists mako.sidebar.config"

echo "== omnibox"
check load-hidden-below-cap sh -c "! $M $P exists mako.sidebar.load"
$M "$P" menu File "Open Location…"; sleep 0.3
$M "$P" shot "$E/omnibox-this-page-green.png" >/dev/null
check this-page-ring-is-its-trails-colour ringis "$E/omnibox-this-page-green.png" "slot 0"
$M "$P" press-id mako.omnibox.scrim; sleep 0.3
$M "$P" menu File "New Trail"; sleep 0.3
check no-status-without-a-message sh -c "! $M $P exists mako.omnibox.status"
check field-names-a-new-trail sh -c "$M $P tree | grep -q 'id=\"mako.omnibox.field\".*desc=\"New trail'"
check address-placeholder sh -c "$M $P tree | grep -q 'id=\"mako.omnibox.field\".*placeholder=\"Search or enter address\"'"
$M "$P" shot "$E/omnibox-new-trail.png" >/dev/null
check new-trail-ring-is-the-next-trails-colour ringis "$E/omnibox-new-trail.png" "slot 1"
$M "$P" set mako.omnibox.field "$U/c.html?unsent"
$M "$P" shot "$E/omnibox-white-page.png" >/dev/null
cp "$J" "$E/pre-scrim.json"
$M "$P" press-id mako.omnibox.scrim; sleep 0.3
check scrim-closes-omnibox sh -c "! $M $P exists mako.omnibox"
check scrim-drops-typed-text cmp -s "$J" "$E/pre-scrim.json"
omni "New Trail" "$U/c.html?t2"
check new-trail is 's["roots"]' "[1, 4]"
$M "$P" menu Trails "Move Page Up"; sleep 0.4
check root-moves-its-trail-up is '(s["roots"], s["colors"])' "([4, 1], {'1': 0, '4': 1})"
$M "$P" menu Trails "Move Page Down"; sleep 0.4
check root-moves-its-trail-down is 's["roots"]' "[1, 4]"
check load-shown-at-cap test "$($M "$P" value mako.sidebar.load)" = "🧠 2/2"
omni "New Trail" "$U/c.html?t3" 1
check third-trail-refused is 'len(s["roots"])' 2
check cap-message sh -c "$M $P value mako.omnibox.status | head -1 | grep -q 'trail cap reached (2)'"
$M "$P" shot "$E/omnibox-cap-error.png" >/dev/null
$M "$P" menu File "New Page in Trail"; sleep 0.3
check reopened-omnibox-drops-the-message sh -c "! $M $P exists mako.omnibox.status"
check field-names-a-page-beneath sh -c "$M $P tree | grep -q 'id=\"mako.omnibox.field\".*desc=\"New page beneath'"
$M "$P" shot "$E/omnibox-child-blue.png" >/dev/null
check page-beneath-ring-is-the-active-trails-colour ringis "$E/omnibox-child-blue.png" "slot 1"
omni "New Page in Trail" "$U/c.html?child"
check new-page-is-child is 'n["5"]["parent"]' 4
omni "Open Location…" "$U/c.html?inplace"
check open-location-stays-in-page is '(len(n), n["5"]["url"].endswith("inplace"))' "(5, True)"
omni "Open Location…" "$U/dark.html"
$M "$P" menu File "Open Location…"; sleep 0.3
$M "$P" shot "$E/omnibox-dark-page.png" >/dev/null
check this-page-ring-follows-the-active-trail ringis "$E/omnibox-dark-page.png" "slot 1"
$M "$P" press-id mako.omnibox.scrim; sleep 0.3

echo "== close and undo"
cp "$J" "$E/pre-close.json"
$M "$P" press-id mako.trail.4; sleep 0.5; cp "$J" "$E/pre-close.json"
$M "$P" menu File "Close Page"; sleep 0.8
check close-removes-subtree is '(s["roots"], len(n), len(s["closed"]))' "([1], 3, 1)"
check close-moves-to-neighbour is 's["active"]' 1
$M "$P" menu File "Reopen Closed Page"; sleep 1
check undo-restores-exact-state cmp -s "$J" "$E/pre-close.json"
$M "$P" press-id mako.trail.5; sleep 0.4; $M "$P" menu File "Close Page"; sleep 0.6
$C quit >/dev/null; sleep 1; $C relaunch >/dev/null; P=$($C pid); sleep 3
$M "$P" menu File "Reopen Closed Page"; sleep 1
check undo-works-after-restart is '(n["5"]["parent"], s["active"], len(s["closed"]))' "(4, 5, 0)"
check width-survives-restart test "$($M "$P" value mako.divider)" = 300

echo "== move and rename"
$M "$P" menu Trails "Outdent Page"; sleep 0.4
check outdent-into-a-third-trail-refused is '(n["5"]["parent"], s["roots"])' "(4, [1, 4])"
$M "$P" press-id mako.trail.4; sleep 0.4; omni "New Page in Trail" "$U/c.html?six"
check second-child is 'n["4"]["children"]' "[5, 6]"
$M "$P" menu Trails "Move Page Up"; sleep 0.4
check move-up is 'n["4"]["children"]' "[6, 5]"
$M "$P" menu Trails "Move Page Down"; sleep 0.4
check move-down is 'n["4"]["children"]' "[5, 6]"
$M "$P" menu Trails "Indent Page"; sleep 0.4
check indent-goes-under-the-page-above is '(n["6"]["parent"], n["5"]["children"])' "(5, [6])"
$M "$P" menu Trails "Outdent Page"; sleep 0.4
check outdent-lands-after-its-parent is '(n["6"]["parent"], n["4"]["children"])' "(4, [5, 6])"
$M "$P" menu Trails "Rename Page…"; sleep 0.4
$M "$P" set mako.trail.6.name "Mine"; $M "$P" confirm mako.trail.6.name; sleep 0.5
check rename is 'n["6"]["name"]' Mine
check renamed-page-titles-the-window test "$($M "$P" title)" = Mine
check each-page-listed-once test "$($M "$P" tree | grep -c 'id=\"mako\.trail\.[0-9]*\"')" = "$(q 'len(n)')"
$M "$P" press-id mako.trail.5; sleep 0.4; $M "$P" menu Trails "Move Page Up"; sleep 0.4
check move-up-from-first-page-takes-the-root-at-the-cap is '(s["roots"], n["5"]["children"], n["4"]["children"], s["colors"]["5"])' "([1, 5], [4], [6], 1)"
$M "$P" press-id mako.trail.4; sleep 0.4; $M "$P" menu Trails "Move Page Up"; sleep 0.4
check move-up-again-gives-the-root-back is '(s["roots"], n["4"]["children"], s["colors"]["4"])' "([1, 4], [5, 6], 1)"
$M "$P" press-id mako.trail.6; sleep 0.4

echo "== find in page"
$M "$P" menu Edit "Find…"; sleep 0.3
check find-placeholder sh -c "$M $P tree | grep -q 'id=\"mako.omnibox.field\".*placeholder=\"Find in page\"'"
$M "$P" shot "$E/omnibox-find.png" >/dev/null
check find-ring-is-neutral-ink ringis "$E/omnibox-find.png" neutral
$M "$P" set mako.omnibox.field "leaf"; $M "$P" confirm mako.omnibox.field; sleep 0.8
check find-hit sh -c "! $M $P value mako.omnibox.status | grep -q 'Not found'"
$M "$P" set mako.omnibox.field "zzzqqq"; $M "$P" confirm mako.omnibox.field; sleep 0.8
check find-miss sh -c "$M $P value mako.omnibox.status | head -1 | grep -q 'Not found'"
$M "$P" shot "$E/sidebar.png" >/dev/null

echo "== deep pages at the narrowest sidebar"
for i in 1 2 3 4 5; do omni "New Page in Trail" "$U/c.html?deep$i" 1; done
check chain-reaches-depth-six is '(n["10"]["parent"], n["11"]["parent"])' "(9, 10)"
$M "$P" set mako.divider 100; sleep 0.5
check width-floor-is-160 test "$($M "$P" value mako.divider)" = 160
$M "$P" shot "$E/narrow-deep.png" >/dev/null
$M "$P" press-id mako.trail.10; sleep 0.4; $M "$P" menu Trails "Rename Page…"; sleep 0.4
row=$($M "$P" frame mako.trail.10); close=$($M "$P" frame mako.trail.10.close); name=$($M "$P" frame mako.trail.10.name)
echo "depth-5 row [$row] close [$close] name [$name]" > "$E/narrow-deep.txt"
read -r rx _ rw _ <<<"$row"; read -r cx _ _ _ <<<"$close"; read -r nx _ nw _ <<<"$name"
check deep-name-keeps-40pt test "${nw:-0}" -ge 40
check deep-name-clear-of-close test $((nx + nw)) -le "${cx:-0}"
check deep-name-inside-row test "${nx:-0}" -ge "${rx:-1}"
log show --last 5m --predicate "processID == $P" 2>/dev/null > "$E/narrow-deep.log"
check no-broken-constraints sh -c "! grep -q 'Unable to simultaneously satisfy' '$E/narrow-deep.log'"

after=$(front)
if [ "$after" = "$before" ]; then pass never-took-focus; else fail "never-took-focus (front was $before, now $after)"; fi
echo "== $fails failure(s); evidence in $E"
exit "$fails"
