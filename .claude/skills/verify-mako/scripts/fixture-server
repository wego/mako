#!/usr/bin/env python3
# fixture-server <port>: serves fixtures/trails on 127.0.0.1. /favicon.ico answers only
# after 3 s, with fav.png, so a page's declared icon is asked for while it is pending.
import functools, http.server, os, sys, time

root = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "fixtures", "trails")

class Handler(http.server.SimpleHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/favicon.ico":
            time.sleep(3)
            self.path = "/fav.png"
        super().do_GET()

    def log_message(self, *args):
        pass

http.server.ThreadingHTTPServer(("127.0.0.1", int(sys.argv[1])), functools.partial(Handler, directory=root)).serve_forever()
