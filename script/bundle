#!/bin/sh
# Builds the Rust core + Swift shell (release) and assembles build/Mako.app.
# MAKO_VERSION / MAKO_BUILD set the app version (CI release uses 0.1.<run> and <run>).
# Install: SIGN_IDENTITY="Apple Development: ..." script/bundle && ditto build/Mako.app /Applications/Mako.app
set -eu
cd "$(dirname "$0")/.."
cargo build --release --manifest-path core/Cargo.toml
swift build -c release
app=build/Mako.app/Contents
rm -rf build/Mako.app
mkdir -p "$app/MacOS" "$app/Resources"
cp .build/release/Mako "$app/MacOS/Mako"
cp app/Resources/AppIcon.icns "$app/Resources/"
cat > "$app/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>Mako</string>
  <key>CFBundleIdentifier</key><string>com.wego.mako</string>
  <key>CFBundleExecutable</key><string>Mako</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>${MAKO_VERSION:-0.1.0}</string>
  <key>CFBundleVersion</key><string>${MAKO_BUILD:-1}</string>
  <key>LSMinimumSystemVersion</key><string>26.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>CFBundleURLTypes</key><array><dict>
    <key>CFBundleURLName</key><string>Web URL</string>
    <key>CFBundleURLSchemes</key><array><string>http</string><string>https</string></array>
  </dict></array>
</dict></plist>
PLIST
# SIGN_IDENTITY: a stable cert keeps macOS permissions across rebuilds; default ad-hoc.
# PROVISIONING_PROFILE: a macOS profile granting Apple's browser passkey entitlement
# (com.apple.developer.web-browser.public-key-credential) for com.wego.mako.
# macOS kills a binary that claims the entitlement without such a profile, so it is
# only added when the profile is checked here first.
if [ -n "${PROVISIONING_PROFILE:-}" ]; then
  profile=$(mktemp)
  security cms -D -i "$PROVISIONING_PROFILE" > "$profile" 2>/dev/null || { echo "cannot read $PROVISIONING_PROFILE"; exit 1; }
  get() { /usr/libexec/PlistBuddy -c "Print :$1" "$profile" 2>/dev/null; }
  team=$(get TeamIdentifier:0)
  [ "$(get Platform:0)" = OSX ] || { echo "$PROVISIONING_PROFILE is not a macOS profile ($(get Platform:0))"; exit 1; }
  [ "$(get Entitlements:com.apple.application-identifier)" = "$team.com.wego.mako" ] ||
    { echo "$PROVISIONING_PROFILE is for $(get Entitlements:com.apple.application-identifier), not $team.com.wego.mako"; exit 1; }
  [ "$(get Entitlements:com.apple.developer.web-browser.public-key-credential)" = true ] ||
    { echo "$PROVISIONING_PROFILE does not grant com.apple.developer.web-browser.public-key-credential"; exit 1; }
  cp "$PROVISIONING_PROFILE" "$app/embedded.provisionprofile"
  entitlements=build/Mako.entitlements
  cat > "$entitlements" <<ENT
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>com.apple.application-identifier</key><string>$team.com.wego.mako</string>
  <key>com.apple.developer.team-identifier</key><string>$team</string>
  <key>com.apple.developer.web-browser.public-key-credential</key><true/>
</dict></plist>
ENT
  rm -f "$profile"
  codesign --force --options runtime --entitlements "$entitlements" --sign "${SIGN_IDENTITY:?a profile needs SIGN_IDENTITY from team $team}" build/Mako.app
else
  codesign --force --options runtime --sign "${SIGN_IDENTITY:--}" build/Mako.app
fi
# Only the installed copy should be offered as a browser for http/https links.
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -u "$PWD/build/Mako.app" 2>/dev/null || true
du -sh build/Mako.app
